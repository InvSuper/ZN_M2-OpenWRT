# ============================================
# 目标平台配置
# ============================================
CONFIG_TARGET_qualcommax=y                     # 启用高通AX系列平台架构
CONFIG_TARGET_qualcommax_ipq60xx=y             # 具体选择IPQ60xx芯片组平台
CONFIG_TARGET_MULTI_PROFILE=y                  # 启用多设备编译模式

# ============================================
# 支持的设备列表 - 仅 ZN M2
# ============================================
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y  # ZN M2 (兆能)

# ============================================
# 固件名称配置
# ============================================
CONFIG_VERSIONOPT="AZhan's LibWrt"  # 固件版本选项
CONFIG_VERSION_DIST="LibWrt"        # 固件发行版名称
CONFIG_VERSION_NUMBER="SNAPSHOT"    # 固件版本号

# ============================================
# 无线网络配置（已禁用）
# ============================================
# CONFIG_ATH11K_NSS_SUPPORT is not set              # 禁用ATH11K NSS支持
# CONFIG_DRIVER_11AC_SUPPORT is not set             # 禁用802.11ac支持
# CONFIG_DRIVER_11AX_SUPPORT is not set             # 禁用802.11ax支持
# CONFIG_PACKAGE_hostapd-common is not set          # 禁用hostapd通用组件
# CONFIG_PACKAGE_iw is not set                      # 禁用无线配置工具
# CONFIG_PACKAGE_kmod-ath is not set                # 禁用Atheros无线驱动
# CONFIG_PACKAGE_kmod-ath11k is not set             # 禁用ATH11K无线驱动
# CONFIG_PACKAGE_kmod-ath11k-ahb is not set         # 禁用ATH11K AHB接口驱动
# CONFIG_PACKAGE_kmod-ath11k-pci is not set         # 禁用ATH11K PCI接口驱动
# CONFIG_PACKAGE_ath11k-firmware-ipq6018 is not set # 禁用IPQ6018固件
# CONFIG_PACKAGE_ath11k-firmware-qcn9074 is not set # 禁用QCN9074固件
# CONFIG_PACKAGE_ipq-wifi-cmiot_ax18 is not set     # 禁用CMIOT AX18无线配置
# CONFIG_PACKAGE_ipq-wifi-jdcloud_re-cs-02 is not set # 禁用京东云RE-CS-02无线配置
# CONFIG_PACKAGE_ipq-wifi-jdcloud_re-ss-01 is not set # 禁用京东云RE-SS-01无线配置
# CONFIG_PACKAGE_ipq-wifi-qihoo_v6 is not set       # 禁用奇虎V6无线配置
# CONFIG_PACKAGE_ipq-wifi-redmi_ax5 is not set      # 禁用红米AX5无线配置
# CONFIG_PACKAGE_ipq-wifi-redmi_ax5-jdcloud is not set # 禁用红米AX5京东云版无线配置
# CONFIG_PACKAGE_ipq-wifi-xiaomi_ax1800 is not set  # 禁用小米AX1800无线配置
# CONFIG_PACKAGE_ipq-wifi-zn_m2 is not set          # 禁用ZN M2无线配置
# CONFIG_PACKAGE_kmod-cfg80211 is not set           # 禁用802.11配置模块
# CONFIG_PACKAGE_kmod-mac80211 is not set           # 禁用MAC80211模块
# CONFIG_PACKAGE_wifi-scripts is not set            # 禁用无线脚本
# CONFIG_PACKAGE_wireless-regdb is not set          # 禁用无线 regulatory 数据库
# CONFIG_PACKAGE_wpad-openssl is not set            # 禁用WPA守护进程

# ============================================
# 性能优化配置
# ============================================
CONFIG_COREMARK_ENABLE_MULTITHREADING=y  # 启用Coremark多线程测试
CONFIG_COREMARK_NUMBER_OF_THREADS=16     # Coremark测试线程数
CONFIG_COREMARK_OPTIMIZE_O3=y            # 启用O3优化
CONFIG_PACKAGE_coremark=y                # 包含Coremark性能测试工具

# ============================================
# 内核功能配置
# ============================================
CONFIG_KERNEL_ARM_PMU=y                # 启用ARM性能监控单元
CONFIG_KERNEL_CFQ_GROUP_IOSCHED=y      # 启用CFQ组I/O调度器
CONFIG_KERNEL_CGROUP_DEVICE=y          # 启用设备控制组
CONFIG_KERNEL_CGROUP_FREEZER=y         # 启用控制组冻结功能
# CONFIG_KERNEL_CGROUP_HUGETLB is not set # 禁用大页控制组
CONFIG_KERNEL_CGROUP_NET_PRIO=y        # 启用网络优先级控制组
CONFIG_KERNEL_CGROUP_PERF=y            # 启用性能控制组
# CONFIG_KERNEL_HUGETLBFS is not set      # 禁用大页文件系统
# CONFIG_KERNEL_HUGETLB_PAGE is not set   # 禁用大页支持
# CONFIG_KERNEL_MEMCG_SWAP_ENABLED is not set # 禁用内存控制组交换
CONFIG_KERNEL_NET_CLS_CGROUP=y            # 启用网络分类控制组
CONFIG_KERNEL_PERF_EVENTS=y               # 启用性能事件
# CONFIG_KERNEL_PREEMPT_RCU is not set    # 禁用RCU抢占
# CONFIG_KERNEL_TRANSPARENT_HUGEPAGE is not set # 禁用透明大页
# CONFIG_KERNEL_TRANSPARENT_HUGEPAGE_ALWAYS is not set # 禁用总是使用透明大页

# ============================================
# NSS 硬件加速配置（完整保留）
# ============================================
CONFIG_NSS_DRV_IGS_ENABLE=y                # 启用IGS驱动
CONFIG_NSS_DRV_MAPT_ENABLE=y               # 启用MAP-T驱动
CONFIG_NSS_DRV_PPTP_ENABLE=y               # 启用PPTP驱动
CONFIG_NSS_DRV_SHAPER_ENABLE=y             # 启用流量整形驱动
# CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE is not set # 禁用WiFi卸载
CONFIG_NSS_FIRMWARE_VERSION_12_2=y         # 使用NSS固件版本12.2
# CONFIG_NSS_FIRMWARE_VERSION_12_5 is not set # 不使用NSS固件版本12.5
CONFIG_PACKAGE_kmod-qca-mcs=y              # 包含MCS内核模块
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y      # 包含IGS驱动模块
CONFIG_PACKAGE_kmod-qca-nss-drv-map-t=y    # 包含MAP-T驱动模块
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y    # 包含PPPoE驱动模块
CONFIG_PACKAGE_kmod-qca-nss-drv-pptp=y     # 包含PPTP驱动模块
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y    # 包含QoS队列驱动模块
CONFIG_PACKAGE_kmod-qca-nss-macsec=y       # 包含MACsec驱动模块

# ============================================
# Docker 容器支持 (已禁用)
# ============================================
# CONFIG_DOCKER_CGROUP_OPTIONS is not set    # 禁用Docker控制组选项
# CONFIG_DOCKER_NET_MACVLAN is not set       # 禁用Docker MACVLAN网络
# CONFIG_DOCKER_OPTIONAL_FEATURES is not set # 禁用Docker可选特性
# CONFIG_DOCKER_STO_EXT4 is not set          # 禁用Docker EXT4存储
# CONFIG_PACKAGE_containerd is not set       # 禁用containerd
# CONFIG_PACKAGE_docker is not set           # 禁用Docker
# CONFIG_PACKAGE_docker-compose is not set   # 禁用Docker Compose
# CONFIG_PACKAGE_dockerd is not set          # 禁用Docker守护进程
# CONFIG_PACKAGE_runc is not set             # 禁用runc
# CONFIG_PACKAGE_tini is not set             # 禁用tini
# CONFIG_PACKAGE_cgroupfs-mount is not set   # 禁用cgroupfs挂载工具

# ============================================
# 文件系统支持 (已禁用)
# ============================================
# CONFIG_PACKAGE_btrfs-progs is not set     # 禁用Btrfs工具
# CONFIG_PACKAGE_kmod-fs-btrfs is not set   # 禁用Btrfs文件系统驱动
# CONFIG_PACKAGE_kmod-scsi-core is not set  # 禁用SCSI核心驱动
# CONFIG_PACKAGE_mount-utils is not set     # 禁用挂载工具

# ============================================
# 加密与安全模块
# ============================================
CONFIG_PACKAGE_kmod-crypto-acompress=y               # 包含压缩加密模块
CONFIG_PACKAGE_kmod-crypto-blake2b=y                 # 包含Blake2b哈希模块
CONFIG_PACKAGE_kmod-crypto-kpp=y                     # 包含密钥封装模块
CONFIG_PACKAGE_kmod-crypto-lib-chacha20=y            # 包含ChaCha20加密库
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y    # 包含ChaCha20-Poly1305加密库
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y          # 包含Curve25519密钥交换库
CONFIG_PACKAGE_kmod-crypto-lib-poly1305=y            # 包含Poly1305哈希库
CONFIG_PACKAGE_kmod-crypto-xxhash=y                  # 包含XXHash哈希模块
# CONFIG_PACKAGE_kmod-crypto-aead is not set         # 禁用认证加密模块
# CONFIG_PACKAGE_kmod-crypto-ccm is not set          # 禁用CCM模式
# CONFIG_PACKAGE_kmod-crypto-cmac is not set         # 禁用CMAC模式
# CONFIG_PACKAGE_kmod-crypto-ctr is not set          # 禁用CTR模式
# CONFIG_PACKAGE_kmod-crypto-gcm is not set          # 禁用GCM模式
# CONFIG_PACKAGE_kmod-crypto-gf128 is not set        # 禁用GF128模块
# CONFIG_PACKAGE_kmod-crypto-ghash is not set        # 禁用GHASH模块
# CONFIG_PACKAGE_kmod-crypto-hmac is not set         # 禁用HMAC模块
# CONFIG_PACKAGE_kmod-crypto-manager is not set      # 禁用加密管理器
# CONFIG_PACKAGE_kmod-crypto-michael-mic is not set  # 禁用Michael MIC模块
# CONFIG_PACKAGE_kmod-crypto-null is not set         # 禁用空加密模块
# CONFIG_PACKAGE_kmod-crypto-rng is not set          # 禁用随机数生成器
# CONFIG_PACKAGE_kmod-crypto-seqiv is not set        # 禁用序列IV模块
# CONFIG_PACKAGE_kmod-crypto-sha3 is not set         # 禁用SHA3模块
# CONFIG_PACKAGE_kmod-crypto-sha512 is not set       # 禁用SHA512模块

# ============================================
# 网络功能模块
# ============================================
CONFIG_PACKAGE_ip-full=y                # 包含完整的ip工具
# CONFIG_PACKAGE_ip-tiny is not set     # 不使用精简版ip工具
CONFIG_PACKAGE_ip6tables-nft=y          # 包含IPv6表NFT支持
CONFIG_PACKAGE_iptables-mod-extra=y     # 包含额外的iptables模块
CONFIG_PACKAGE_iptables-nft=y           # 包含iptables NFT支持
CONFIG_PACKAGE_xtables-nft=y            # 包含xtables NFT支持
CONFIG_PACKAGE_kmod-br-netfilter=y      # 包含桥接网络过滤器模块
CONFIG_PACKAGE_kmod-dummy=y             # 包含虚拟网络接口模块
CONFIG_PACKAGE_kmod-ifb=y               # 包含中间缓冲设备模块
CONFIG_PACKAGE_kmod-inet-diag=y         # 包含网络诊断模块
CONFIG_PACKAGE_kmod-ip6tables=y         # 包含IPv6表模块
CONFIG_PACKAGE_kmod-ipt-conntrack=y     # 包含连接跟踪模块
CONFIG_PACKAGE_kmod-ipt-core=y          # 包含iptables核心模块
CONFIG_PACKAGE_kmod-ipt-extra=y         # 包含额外的iptables模块
CONFIG_PACKAGE_kmod-ipt-nat=y           # 包含NAT模块
CONFIG_PACKAGE_kmod-ipt-nat6=y          # 包含IPv6 NAT模块
CONFIG_PACKAGE_kmod-ipt-physdev=y       # 包含物理设备匹配模块
# CONFIG_PACKAGE_kmod-macvlan is not set# 禁用MACVLAN模块
CONFIG_PACKAGE_kmod-nat46=y             # 包含NAT46模块
CONFIG_PACKAGE_kmod-netlink-diag=y      # 包含Netlink诊断模块
CONFIG_PACKAGE_kmod-nf-ipt=y            # 包含Netfilter IPT模块
CONFIG_PACKAGE_kmod-nf-ipt6=y           # 包含Netfilter IPT6模块
# CONFIG_PACKAGE_kmod-nf-ipvs is not set# 禁用IPVS模块
CONFIG_PACKAGE_kmod-nf-nat6=y           # 包含Netfilter NAT6模块
CONFIG_PACKAGE_kmod-nf-tproxy=y         # 包含透明代理模块
CONFIG_PACKAGE_kmod-nft-compat=y        # 包含NFT兼容性模块
CONFIG_PACKAGE_kmod-nft-tproxy=y        # 包含NFT透明代理模块
CONFIG_PACKAGE_kmod-sched-core=y        # 包含调度核心模块
CONFIG_PACKAGE_kmod-tun=y               # 包含TUN/TAP模块
# CONFIG_PACKAGE_kmod-veth is not set   # 禁用虚拟以太网模块
CONFIG_PACKAGE_kmod-wireguard=y         # 包含WireGuard VPN模块

# ============================================
# USB 支持 (已禁用)
# ============================================
# CONFIG_PACKAGE_kmod-usb-dwc2 is not set        # 禁用DWC2 USB驱动
# CONFIG_PACKAGE_kmod-usb-dwc2-pci is not set    # 禁用DWC2 PCI USB驱动
# CONFIG_PACKAGE_kmod-usb-ehci is not set        # 禁用EHCI USB驱动
# CONFIG_PACKAGE_kmod-usb-ohci is not set        # 禁用OHCI USB驱动
# CONFIG_PACKAGE_kmod-usb-phy-nop is not set     # 禁用USB PHY nop驱动
# CONFIG_PACKAGE_kmod-usb-roles is not set       # 禁用USB角色切换
# CONFIG_PACKAGE_kmod-usb-storage is not set     # 禁用USB存储支持
# CONFIG_PACKAGE_kmod-usb-storage-extras is not set # 禁用额外的USB存储支持
# CONFIG_PACKAGE_kmod-usb-uhci is not set        # 禁用UHCI USB驱动
# CONFIG_PACKAGE_kmod-usb2 is not set            # 禁用USB2支持
# CONFIG_PACKAGE_kmod-usb2-pci is not set        # 禁用USB2 PCI支持

# ============================================
# 压缩库支持 (部分禁用，仅保留系统必需)
# ============================================
# CONFIG_PACKAGE_kmod-lib-lzo is not set     # 禁用LZO压缩库
# CONFIG_PACKAGE_kmod-lib-raid6 is not set   # 禁用RAID6库
# CONFIG_PACKAGE_kmod-lib-xor is not set     # 禁用XOR库
CONFIG_PACKAGE_kmod-lib-xxhash=y             # 包含XXHash库
CONFIG_PACKAGE_kmod-lib-zlib-deflate=y       # 包含zlib压缩库
CONFIG_PACKAGE_kmod-lib-zlib-inflate=y       # 包含zlib解压缩库
# CONFIG_PACKAGE_kmod-lib-zstd is not set    # 禁用Zstd库
# CONFIG_PACKAGE_liblzo is not set           # 禁用liblzo

# ============================================
# 系统库文件
# ============================================
CONFIG_PACKAGE_libattr=y                 # 包含属性库
CONFIG_PACKAGE_libcap=y                  # 包含能力库
# CONFIG_PACKAGE_libcap-ng is not set    # 禁用libcap-ng
CONFIG_PACKAGE_libiptext=y               # 包含IP文本库
CONFIG_PACKAGE_libiptext-nft=y           # 包含IP文本NFT库
CONFIG_PACKAGE_libiptext6=y              # 包含IPv6文本库
CONFIG_PACKAGE_liblua=y                  # 包含Lua库
CONFIG_PACKAGE_liblucihttp=y             # 包含LuCI HTTP库
CONFIG_PACKAGE_liblucihttp-lua=y         # 包含LuCI HTTP Lua绑定
CONFIG_PACKAGE_liblucihttp-ucode=y       # 包含LuCI HTTP ucode绑定
# CONFIG_PACKAGE_libmount is not set     # 禁用挂载库
CONFIG_PACKAGE_libncurses=y              # 包含ncurses库
# CONFIG_PACKAGE_libseccomp is not set   # 禁用seccomp库
CONFIG_PACKAGE_libubus-lua=y             # 包含ubus Lua绑定
CONFIG_PACKAGE_libuv=y                   # 包含libuv库
CONFIG_PACKAGE_libwebsockets-full=y      # 包含完整的websockets库
CONFIG_PACKAGE_libxtables=y              # 包含xtables库
CONFIG_PACKAGE_libmbedtls=y              # 包含mbedTLS加密库（修复：从 m 改为 y）

# ============================================
# LuCI Web 界面核心
# ============================================
CONFIG_PACKAGE_lua=y                      # 包含Lua解释器
CONFIG_PACKAGE_luci=y                     # 包含LuCI核心
CONFIG_PACKAGE_luci-base=y                # 包含LuCI基础
CONFIG_PACKAGE_luci-compat=y              # 包含LuCI兼容性
CONFIG_PACKAGE_luci-light=y               # 包含LuCI轻量版本
CONFIG_PACKAGE_luci-lua-runtime=y         # 包含LuCI Lua运行时
CONFIG_PACKAGE_luci-mod-admin-full=y      # 包含完整的管理模块
CONFIG_PACKAGE_luci-mod-network=y         # 包含网络模块
CONFIG_PACKAGE_luci-mod-status=y          # 包含状态模块
CONFIG_PACKAGE_luci-mod-system=y          # 包含系统模块
CONFIG_PACKAGE_luci-lib-base=y            # 包含基础库
# CONFIG_PACKAGE_luci-lib-docker is not set # 禁用Docker库
CONFIG_PACKAGE_luci-lib-ip=y              # 包含IP库
CONFIG_PACKAGE_luci-lib-jsonc=y           # 包含JSONC库
CONFIG_PACKAGE_luci-lib-nixio=y           # 包含NIXIO库
CONFIG_PACKAGE_luci-lib-uqr=y             # 包含UQR库
CONFIG_PACKAGE_luci-proto-ipv6=y          # 包含IPv6协议支持
CONFIG_PACKAGE_luci-proto-ppp=y           # 包含PPP协议支持
CONFIG_PACKAGE_luci-proto-wireguard=y     # 包含WireGuard协议支持
CONFIG_PACKAGE_luci-theme-argon=y         # 包含Argon主题
CONFIG_PACKAGE_luci-theme-bootstrap=y     # 包含Bootstrap主题

# ============================================
# LuCI 应用程序（已禁用科学上网）
# ============================================
CONFIG_PACKAGE_luci-app-argon-config=y      # 包含Argon主题配置
# CONFIG_PACKAGE_luci-app-dockerman is not set # 禁用Docker管理
CONFIG_PACKAGE_luci-app-firewall=y          # 包含防火墙管理
# CONFIG_PACKAGE_luci-app-homeproxy is not set # 禁用HomeProxy
CONFIG_PACKAGE_luci-app-package-manager=y   # 包含包管理器
CONFIG_PACKAGE_luci-app-ttyd=y              # 包含TTYD终端
CONFIG_PACKAGE_luci-app-upnp=y              # 包含UPnP配置
CONFIG_PACKAGE_luci-app-wol=y               # 包含Wake-on-LAN
# CONFIG_PACKAGE_luci-app-athena-led is not set # 禁用LED控制

# ============================================
# LuCI 中文语言包
# ============================================
CONFIG_LUCI_LANG_zh_Hans=y                          # 启用中文语言
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y       # 包含Argon配置中文语言包
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y               # 包含基础中文语言包
# CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn is not set # 禁用Docker管理中文语言包
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y           # 包含防火墙中文语言包
# CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn is not set # 禁用HomeProxy中文语言包
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y    # 包含包管理器中文语言包
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y               # 包含TTYD中文语言包
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y               # 包含UPnP中文语言包
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y                # 包含WOL中文语言包
# CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn is not set # 禁用LED控制中文语言包

# ============================================
# 网络应用与服务（已禁用科学上网）
# ============================================
# CONFIG_PACKAGE_chinadns-ng is not set       # 禁用ChinaDNS-NG
CONFIG_PACKAGE_wireguard-tools=y              # 包含WireGuard工具
CONFIG_PACKAGE_miniupnpd-nftables=y           # 包含miniupnpd NFT支持
CONFIG_PACKAGE_etherwake=y                    # 包含网络唤醒工具
# CONFIG_SING_BOX_BUILD_ACME is not set       # 禁用SingBox ACME支持
# CONFIG_SING_BOX_BUILD_CLASH_API is not set  # 禁用SingBox Clash API
# CONFIG_SING_BOX_BUILD_ECH is not set        # 禁用SingBox ECH支持
# CONFIG_SING_BOX_BUILD_GVISOR is not set     # 禁用SingBox gVisor支持
# CONFIG_SING_BOX_BUILD_QUIC is not set       # 禁用SingBox QUIC支持
# CONFIG_SING_BOX_BUILD_REALITY_SERVER is not set # 禁用SingBox Reality服务器
# CONFIG_SING_BOX_BUILD_UTLS is not set       # 禁用SingBox uTLS支持
# CONFIG_SING_BOX_BUILD_WIREGUARD is not set  # 禁用SingBox WireGuard支持

# ============================================
# 系统工具
# ============================================
CONFIG_PACKAGE_ca-certificates=y        # 包含CA证书
CONFIG_PACKAGE_cgi-io=y                 # 包含CGI I/O工具
CONFIG_PACKAGE_default-settings=y       # 包含默认设置
CONFIG_PACKAGE_default-settings-chn=y   # 包含中文默认设置
CONFIG_PACKAGE_htop=y                   # 包含htop进程查看器
CONFIG_PACKAGE_terminfo=y               # 包含终端信息
CONFIG_PACKAGE_ttyd=y                   # 包含TTYD终端
CONFIG_PACKAGE_resolveip=y              # 包含resolveip工具

# ============================================
# RPC 与包管理
# ============================================
CONFIG_PACKAGE_opkg=y                  # 包含OPKG包管理器
CONFIG_OPKG_USE_CURL=y                 # 启用OPKG使用CURL
CONFIG_PACKAGE_rpcd=y                  # 包含RPC守护进程
CONFIG_PACKAGE_rpcd-mod-file=y         # 包含文件RPC模块
CONFIG_PACKAGE_rpcd-mod-iwinfo=y       # 包含iwinfo RPC模块
CONFIG_PACKAGE_rpcd-mod-luci=y         # 包含LuCI RPC模块
CONFIG_PACKAGE_rpcd-mod-rrdns=y        # 包含rrdns RPC模块
CONFIG_PACKAGE_rpcd-mod-ucode=y        # 包含ucode RPC模块

# ============================================
# Web 服务器
# ============================================
CONFIG_PACKAGE_uhttpd=y              # 包含uHTTPd服务器
CONFIG_PACKAGE_uhttpd-mod-ubus=y     # 包含uHTTPd ubus模块

# ============================================
# ucode 模块
# ============================================
CONFIG_PACKAGE_ucode-mod-html=y       # 包含HTML ucode模块
CONFIG_PACKAGE_ucode-mod-lua=y        # 包含Lua ucode模块
CONFIG_PACKAGE_ucode-mod-math=y       # 包含数学 ucode模块
# CONFIG_PACKAGE_ucode-mod-digest is not set  # 禁用摘要 ucode模块
# CONFIG_PACKAGE_ucode-mod-nl80211 is not set # 禁用nl80211 ucode模块
# CONFIG_PACKAGE_ucode-mod-rtnl is not set  # 禁用rtnl ucode模块
# CONFIG_PACKAGE_ucode-mod-uloop is not set # 禁用uloop ucode模块

# ============================================
# 其他禁用的包
# ============================================
# CONFIG_FORTIFY_SOURCE is not set               # 禁用源强化
# CONFIG_PACKAGE_apk-mbedtls is not set          # 禁用APK mbedTLS
# CONFIG_PACKAGE_apk-openssl is not set          # 禁用APK OpenSSL
# CONFIG_PACKAGE_kmod-hwmon-core is not set      # 禁用硬件监控核心
# CONFIG_PACKAGE_kmod-i2c-core is not set        # 禁用I2C核心
# CONFIG_PACKAGE_kmod-mhi-bus is not set         # 禁用MHI总线
# CONFIG_PACKAGE_kmod-qrtr-mhi is not set        # 禁用QRTR MHI
# CONFIG_PACKAGE_kmod-qrtr-smd is not set        # 禁用QRTR SMD
# CONFIG_PACKAGE_libopenssl-conf is not set      # 禁用OpenSSL配置
# CONFIG_PACKAGE_libopenssl-legacy is not set    # 禁用OpenSSL遗留支持

# ============================================
# mbedTLS 加密库配置
# ============================================
CONFIG_MBEDTLS_AES_C=y                         # 启用AES加密
# CONFIG_MBEDTLS_ARIA_C is not set             # 禁用ARIA加密
# CONFIG_MBEDTLS_CAMELLIA_C is not set         # 禁用Camellia加密
# CONFIG_MBEDTLS_CCM_C is not set              # 禁用CCM模式
# CONFIG_MBEDTLS_CIPHER_MODE_OFB is not set    # 禁用OFB模式
# CONFIG_MBEDTLS_CIPHER_MODE_XTS is not set    # 禁用XTS模式
CONFIG_MBEDTLS_CMAC_C=y                        # 启用CMAC
# CONFIG_MBEDTLS_DEBUG_C is not set            # 禁用调试
# CONFIG_MBEDTLS_DEPRECATED_WARNING is not set # 禁用过时警告
CONFIG_MBEDTLS_DES_C=y                         # 启用DES加密
# CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED is not set   # 禁用BP256R1曲线
# CONFIG_MBEDTLS_ECP_DP_BP386R1_ENABLED is not set   # 禁用BP386R1曲线
# CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED is not set   # 禁用BP512R1曲线
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y           # 启用Curve25519曲线
# CONFIG_MBEDTLS_ECP_DP_CURVE448_ENABLED is not set  # 禁用Curve448曲线
# CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED is not set # 禁用SECP192K1曲线
# CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED is not set # 禁用SECP192R1曲线

# ============================================
# 最终版：6个插件
# ============================================
# 1. SmartDNS
CONFIG_PACKAGE_smartdns=y                       # 包含SmartDNS
CONFIG_PACKAGE_luci-app-smartdns=y              # 包含SmartDNS LuCI界面
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=y       # 包含SmartDNS中文语言包

# 2. AdGuard Home
CONFIG_PACKAGE_adguardhome=y                    # 包含AdGuard Home
CONFIG_PACKAGE_luci-app-adguardhome=y           # 包含AdGuard Home LuCI界面
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y    # 包含AdGuard Home中文语言包

# 3. Tailscale
CONFIG_PACKAGE_tailscale=y                      # 包含Tailscale
CONFIG_PACKAGE_luci-app-tailscale=y             # 包含Tailscale LuCI界面
CONFIG_PACKAGE_luci-i18n-tailscale-zh-cn=y      # 包含Tailscale中文语言包

# 5. Bandix 流量监控
CONFIG_PACKAGE_bandix=n                         # Bandix
CONFIG_PACKAGE_luci-app-bandix=n                # Bandix LuCI界面
CONFIG_PACKAGE_luci-i18n-bandix-zh-cn=n         # Bandix中文语言包

# 6. WeChatPush 微信推送
CONFIG_PACKAGE_luci-app-wechatpush=y            # 包含WeChatPush LuCI界面
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y     # 包含WeChatPush中文语言包
